{
  "id": "external-app-tab",
  "name": "External App Tab",
  "description": "Pin a compatible self-hosted web app as a tab inside Hermes WebUI via an iframe, or browse the profile's trusted workspaces and preview local files (HTML first) in a sandboxed frame with a top-bar workspace switcher and a collapsible file list.",
  "version": "0.2.0",
  "author": "nesquena-hermes",
  "assets": {
    "scripts": [
      "assets/external-app-tab.js"
    ],
    "stylesheets": [
      "assets/external-app-tab.css"
    ]
  },
  "capabilities": [
    "manifest-bundle"
  ],
  "lifecycle": {
    "webui_restart_required": false,
    "sidecar_start_required": false,
    "native_host_start_required": false,
    "native_host_autostart": "none"
  },
  "screenshots": [],
  "permissions": {
    "webui_api": {
      "read": [
        "session",
        "/api/workspaces",
        "/api/list",
        "/api/file",
        "/api/file/raw"
      ],
      "write": [
        "/api/session/new"
      ]
    },
    "webui_navigation": false,
    "dom": {
      "owned": true,
      "mutates_core_views": true
    },
    "storage": {
      "owned": true,
      "shared_webui_keys": []
    },
    "loopback_sidecar": false,
    "native_host": false,
    "filesystem": {
      "arbitrary": false,
      "serves_bundled_assets": true
    },
    "network_external": true,
    "embeds_iframe": true,
    "requires_csp_frame_extra": true
  },
  "settings_schema": [
    {
      "key": "mode",
      "type": "string",
      "label": "Mode (external URL or workspace files)",
      "default": "external"
    },
    {
      "key": "url",
      "type": "string",
      "label": "App URL",
      "default": ""
    },
    {
      "key": "label",
      "type": "string",
      "label": "Rail label",
      "default": "App"
    },
    {
      "key": "workspace",
      "type": "string",
      "label": "Workspace path",
      "default": ""
    },
    {
      "key": "lastFile",
      "type": "string",
      "label": "Last previewed file",
      "default": ""
    }
  ]
}
