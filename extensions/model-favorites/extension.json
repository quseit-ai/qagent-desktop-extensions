      "mutates_core_views": true
    },
    "storage": {
      "owned": [
        "hermes-ext-model-favorites"
      ],
      "shared_webui_keys": []
    },
    "loopback_sidecar": false,
    "native_host": false,
    "filesystem": {
      "arbitrary": false,
      "serves_bundled_assets": true
    },
    "network_external": false
  }
}
