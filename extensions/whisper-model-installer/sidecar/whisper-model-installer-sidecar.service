# Whisper Model Installer sidecar - token-v1 loopback backend for the whisper-model-installer WebUI extension.
# WebUI provisions the proxy token in the state dir; the scaffold resolves it. No token here.
# Install: cp to ~/.config/systemd/user/ then `systemctl --user enable --now whisper-model-installer-sidecar`
[Unit]
Description=Whisper Model Installer sidecar (faster-whisper-base download backend, token-v1)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.hermes/webui/extensions/whisper-model-installer/sidecar
Environment=HERMES_WEBUI_STATE_DIR=%h/.hermes/webui
ExecStart=/usr/bin/python3 -S -u sidecar.py
Restart=on-failure

[Install]
WantedBy=default.target
